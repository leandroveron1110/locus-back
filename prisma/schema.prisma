generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Status {
  id          String     @id @default(uuid()) @map("id")
  name        String     @map("nombre")
  displayName String     @map("nombre_visual")
  description String?    @map("descripcion")
  entityType  String     @map("tipo_entidad")
  isFinal     Boolean    @default(false) @map("es_final")
  order       Int        @default(0) @map("orden")
  createdAt   DateTime   @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  businesses  Business[] @relation("BusinessStatus")
  users       User[]     @relation("UserStatus")

  @@unique([name, entityType])
  @@map("estados")
}

model User {
  id               String             @id @default(uuid()) @map("id")
  firstName        String             @map("nombre")
  lastName         String             @map("apellido")
  email            String             @unique @map("email")
  phone            String?            @map("telefono")
  passwordHash     String             @map("password_hash")
  role             UserRole           @default(CLIENT) @map("rol")
  createdAt        DateTime           @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  statusId         String?            @map("estado_id")
  avatarId         String?            @unique @map("avatar_id")
  isDeleted        Boolean            @default(false) @map("borrado")
  deletedAt        DateTime?          @map("fecha_borrado")
  businessFollower BusinessFollower[]
  DeliveryCompany  DeliveryCompany[]
  deliveryEmployee DeliveryEmployee[]
  rating           Rating[]
  address          Address[]          @relation("UserAddresses")
  businessEmployee BusinessEmployee[]
  businesses       Business[]
  Order            Order[]
  avatar           Image?             @relation("UserAvatar", fields: [avatarId], references: [id])
  currentStatus    Status?            @relation("UserStatus", fields: [statusId], references: [id])

  @@map("usuarios")
}

model Category {
  id                 String             @id @default(uuid()) @map("id")
  name               String             @unique @map("nombre")
  description        String?            @map("descripcion")
  active             Boolean            @default(true) @map("activo")
  createdAt          DateTime           @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  isDeleted          Boolean            @default(false) @map("borrado")
  deletedAt          DateTime?          @map("fecha_borrado")
  businessCategories BusinessCategory[]

  @@map("categorias")
}

model Image {
  id                String          @id @default(uuid()) @map("id")
  name              String          @map("nombre")
  altText           String?         @map("alt")
  description       String?         @map("descripcion")
  tags              String[]        @map("etiquetas")
  url               String          @map("url")
  publicId          String          @unique @map("public_id")
  format            String?         @map("formato")
  resourceType      String          @default("image") @map("tipo_recurso")
  width             Int?            @map("ancho")
  height            Int?            @map("alto")
  bytes             BigInt?         @map("bytes")
  folder            String?         @map("carpeta")
  isCustomizedImage Boolean         @default(false) @map("es_imagen_personalizada")
  type              ImageType       @default(GENERAL)
  createdAt         DateTime        @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  MenuProduct       MenuProduct[]   @relation("MenuProductImage")
  businessGalleries BusinessImage[] @relation("businessGalleries")
  businessLogo      Business?       @relation("BusinessLogo")
  userAvatar        User?           @relation("UserAvatar")

  @@index([isCustomizedImage, type])
  @@index([folder])
  @@index([name])
  @@map("imagenes")
}

model BusinessImage {
  businessId String   @map("negocio_id")
  imageId    String   @map("imagen_id")
  order      Int?     @map("orden")
  imageUrl   String?  @map("url")
  image      Image    @relation("businessGalleries", fields: [imageId], references: [id], onDelete: Cascade)
  business   Business @relation("BusinessGalleryImages", fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, imageId])
  @@map("negocio_imagenes")
}

model BusinessCategory {
  businessId String   @map("negocio_id")
  categoryId String   @map("categoria_id")
  assignedAt DateTime @default(now()) @map("fecha_asignacion")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, categoryId])
  @@map("negocio_categorias")
}

model Rating {
  id         String   @id @default(uuid())
  value      Int
  comment    String?
  createdAt  DateTime @default(now())
  businessId String
  userId     String
  business   Business @relation(fields: [businessId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([businessId, userId])
}

model BusinessFollower {
  id         String   @id @default(uuid())
  userId     String
  businessId String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, businessId])
}

model BusinessTag {
  businessId String
  tagId      String
  assignedAt DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([businessId, tagId])
  @@map("negocio_tag")
}

model Tag {
  id          String        @id @default(uuid()) @map("id")
  name        String        @unique @map("nombre")
  active      Boolean       @default(true) @map("activo")
  createdAt   DateTime      @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  isDeleted   Boolean       @default(false) @map("borrado")
  deletedAt   DateTime?     @map("fecha_borrado")
  BusinessTag BusinessTag[]

  @@map("tags")
}

model OfferedService {
  id              String   @id @default(uuid()) @map("id")
  businessId      String   @map("negocio_id")
  name            String   @map("nombre")
  description     String?  @map("descripcion")
  price           Decimal? @map("precio") @db.Decimal(10, 2)
  durationMinutes Int?     @map("duracion_minutos")
  active          Boolean  @default(true) @map("activo")
  createdAt       DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("servicios_ofrecidos")
}

model Business {
  id                    String                  @id @default(uuid()) @map("id")
  ownerId               String                  @map("propietario_id")
  name                  String
  shortDescription      String?                 @map("descripcion_corta")
  fullDescription       String?                 @map("descripcion_completa")
  address               String                  @map("direccion")
  phone                 String                  @map("telefono")
  whatsapp              String
  email                 String?
  statusId              String?                 @map("estado_id")
  createdAt             DateTime                @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  instagramUrl          String?                 @map("url_instagram")
  facebookUrl           String?                 @map("url_facebook")
  websiteUrl            String?                 @map("url_web")
  modulesConfig         Json?                   @default("{}") @map("modulos_config")
  latitude              Decimal?                @map("latitud") @db.Decimal(10, 7)
  longitude             Decimal?                @map("longitud") @db.Decimal(10, 7)
  averageRating         Decimal?                @map("promedio_calificacion") @db.Decimal(2, 1)
  ratingsCount          Int?                    @default(0) @map("cantidad_calificaciones")
  logoId                String?                 @unique @map("logo_id")
  logoUrl               String?                 @map("logo_url")
  horarios              Json?                   @map("horarios")
  isDeleted             Boolean                 @default(false) @map("borrado")
  deletedAt             DateTime?               @map("fecha_borrado")
  acceptsCash           Boolean                 @default(true) @map("acepta_efectivo")
  acceptsTransfer       Boolean                 @default(true) @map("acepta_transferencia")
  acceptsQr             Boolean                 @default(false) @map("acepta_qr")
  businessFollower      BusinessFollower[]
  ratings               Rating[]
  Address               Address[]               @relation("BusinessAddresses")
  businessEmployee      BusinessEmployee[]
  menu                  Menu[]
  businessPaymentMethod BusinessPaymentMethod[]
  businessCategories    BusinessCategory[]
  galleryImages         BusinessImage[]         @relation("BusinessGalleryImages")
  businessTags          BusinessTag[]
  currentStatus         Status?                 @relation("BusinessStatus", fields: [statusId], references: [id])
  logo                  Image?                  @relation("BusinessLogo", fields: [logoId], references: [id])
  owner                 User                    @relation(fields: [ownerId], references: [id])
  Order                 Order[]
  positions             Position[]
  offeredServices       OfferedService[]

  @@map("negocios")
}

model BusinessPaymentMethod {
  id           String    @id @default(uuid()) @map("id")
  businessId   String    @map("negocio_id")
  alias        String    @map("alias")
  account      String    @map("cuenta")
  holderName   String    @map("titular")
  instructions String?   @map("instrucciones")
  isActive     Boolean   @default(true) @map("activo")
  createdAt    DateTime  @default(now()) @map("creado_en")
  updatedAt    DateTime  @updatedAt @map("actualizado_en")
  isDeleted    Boolean   @default(false) @map("borrado")
  deletedAt    DateTime? @map("fecha_borrado")
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("metodos_pago_negocio")
}

model BusinessRole {
  id          String             @id @default(uuid())
  businessId  String
  name        String
  permissions PermissionEnum[]
  employees   BusinessEmployee[]
}

model BusinessEmployee {
  id           String                     @id @default(uuid())
  businessId   String
  userId       String?
  firstName    String                     @map("nombre")
  lastName     String                     @map("apellido")
  phone        String?                    @map("telefono")
  positionId   String?
  active       Boolean                    @default(true) @map("activo")
  paymentType  EmployeePaymentType        @default(DAILY) @map("tipo_pago")
  paymentRate  Decimal                    @map("valor_pago") @db.Decimal(12, 2)
  username     String?
  passwordHash String?
  roleId       String?
  overrides    BusinessEmployeeOverride[]
  business     Business                   @relation(fields: [businessId], references: [id])
  position     Position?                  @relation(fields: [positionId], references: [id])
  role         BusinessRole?              @relation(fields: [roleId], references: [id])
  user         User?                      @relation(fields: [userId], references: [id])
  workSessions EmployeeWorkSession[]
  settlements  EmployeeSettlement[]

  @@unique([businessId, username])
  @@map("empleados_negocio")
}

model BusinessEmployeeOverride {
  id         String           @id @default(uuid())
  employeeId String
  permission PermissionEnum
  allowed    Boolean
  employee   BusinessEmployee @relation(fields: [employeeId], references: [id])
}

model Position {
  id         String             @id @default(uuid())
  businessId String
  name       String             @map("nombre")
  employees  BusinessEmployee[]
  business   Business           @relation(fields: [businessId], references: [id])

  @@unique([businessId, name])
  @@map("puestos")
}

model EmployeeWorkSession {
  id         String           @id @default(uuid())
  employeeId String
  startedAt  DateTime         @map("inicio")
  endedAt    DateTime?        @map("fin")
  createdAt  DateTime         @default(now()) @map("fecha_creacion")
  employee   BusinessEmployee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, startedAt])
  @@map("jornadas_empleado")
}

model EmployeeSettlement {
  id          String                   @id @default(uuid())
  employeeId  String
  periodStart DateTime                 @map("periodo_inicio")
  periodEnd   DateTime                 @map("periodo_fin")
  amount      Decimal                  @map("monto") @db.Decimal(12, 2)
  status      EmployeeSettlementStatus @default(PENDING)
  paidAt      DateTime?                @map("fecha_pago")
  createdAt   DateTime                 @default(now()) @map("fecha_creacion")
  employee    BusinessEmployee         @relation(fields: [employeeId], references: [id])

  @@index([employeeId, periodStart, periodEnd])
  @@map("liquidaciones_empleados")
}

model DeliveryEmployee {
  id                String               @id @default(uuid())
  deliveryCompanyId String
  userId            String
  role              DeliveryEmployeeRole
  permissions       Json?
  createdAt         DateTime             @default(now())
  deliveryCompany   DeliveryCompany      @relation(fields: [deliveryCompanyId], references: [id])
  user              User                 @relation(fields: [userId], references: [id])
}

model SearchableBusiness {
  id               String   @id @map("id")
  name             String   @map("nombre")
  shortDescription String?  @map("descripcion_corta")
  fullDescription  String?  @map("descripcion_completa")
  address          String?  @map("direccion")
  city             String?  @map("ciudad")
  province         String?  @map("provincia")
  categoryNames    String[] @map("nombres_categorias")
  tagNames         String[] @map("nombres_tags")
  latitude         Decimal? @map("latitud") @db.Decimal(10, 7)
  longitude        Decimal? @map("longitud") @db.Decimal(10, 7)
  averageRating    Decimal? @map("promedio_calificacion") @db.Decimal(2, 1)
  reviewCount      Int?     @default(0) @map("cantidad_calificaciones")
  status           String?  @map("estado")
  logoUrl          String?  @map("url_logo")
  horarios         Json?    @map("horarios")
  modulesConfig    Json?    @map("modulos_config")
  followersCount   Int      @default(0) @map("cantidad_seguidores")
  createdAt        DateTime @default(now()) @map("fecha_creacion_original")
  updatedAt        DateTime @updatedAt @map("fecha_ultima_sincronizacion")

  @@map("negocios_busqueda")
}

/// Representa el menú completo de un negocio. Asumimos 1:1 con Business por ahora.
/// Si un negocio puede tener múltiples menús (ej. Desayuno, Almuerzo), esta relación
/// debería ser de 1:N (Business a Menu), y 'businessId' iría en Menu.
model Menu {
  id         String    @id @default(uuid()) @map("id")
  name       String    @map("nombre")
  businessId String    @map("negocio_id")
  isDeleted  Boolean   @default(false) @map("borrado")
  deletedAt  DateTime? @map("fecha_borrado")
  createdAt  DateTime  @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  business   Business  @relation(fields: [businessId], references: [id])
  sections   Seccion[]

  @@unique([businessId, name])
  @@map("menus")
}

/// Representa una sección o categoría dentro de un menú (ej. "¡Volvió la salsa Tasty!").
model Seccion {
  id           String        @id @default(uuid()) @map("id")
  name         String        @map("nombre")
  index        Int           @map("orden")
  imageUrls    String[]      @map("urls_imagenes")
  menuId       String        @map("menu_id")
  isDeleted    Boolean       @default(false) @map("borrado")
  deletedAt    DateTime?     @map("fecha_borrado")
  createdAt    DateTime      @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  menuProducts MenuProduct[]
  menu         Menu          @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@map("secciones")
}

/// Representa un producto que forma parte de un menú de un negocio.
model MenuProduct {
  id                     String                    @id @default(uuid()) @map("id")
  name                   String                    @map("nombre")
  description            String                    @map("descripcion")
  enabled                Boolean                   @default(true) @map("habilitado")
  available              Boolean                   @default(true) @map("disponible")
  finalPrice             Decimal                   @map("precio_final") @db.Decimal(10, 2)
  originalPrice          Decimal?                  @map("precio_original") @db.Decimal(10, 2)
  currency               String                    @default("ARS") @map("moneda")
  currencyMask           String                    @default("$") @map("mascara_moneda")
  finalPriceWithoutTaxes Decimal?                  @map("precio_sin_impuestos") @db.Decimal(10, 2)
  taxesAmount            Decimal?                  @map("monto_impuestos") @db.Decimal(10, 2)
  cost                   Decimal                   @default(0) @db.Decimal(10, 2)
  discountAmount         Decimal?                  @map("monto_descuento") @db.Decimal(10, 2)
  discountPercentage     Decimal?                  @map("porcentaje_descuento") @db.Decimal(5, 2)
  discountType           String[]                  @map("tipo_descuento")
  imageId                String?                   @map("imagen_id")
  imageUrl               String?                   @map("imagen_url")
  rating                 Float                     @default(0.0) @map("calificacion")
  preparationTime        Int?                      @map("tiempo_preparacion")
  stock                  Int                       @default(0) @map("stock")
  hasOptions             Boolean                   @default(false) @map("tiene_opciones")
  isMostOrdered          Boolean                   @default(false) @map("es_mas_pedido")
  isRecommended          Boolean                   @default(false) @map("es_recomendado")
  seccionId              String                    @map("seccion_id")
  isDeleted              Boolean                   @default(false) @map("borrado")
  deletedAt              DateTime?                 @map("fecha_borrado")
  createdAt              DateTime                  @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt              DateTime                  @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  acceptsCash            Boolean                   @default(true) @map("acepta_efectivo")
  acceptsTransfer        Boolean                   @default(true) @map("acepta_transferencia")
  acceptsQr              Boolean                   @default(false) @map("acepta_qr")
  OrderItem              OrderItem[]
  foodCategories         MenuProductFoodCategory[]
  image                  Image?                    @relation("MenuProductImage", fields: [imageId], references: [id])
  seccion                Seccion                   @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  options                Opcion[]
  optionGroups           OpcionGrupo[]

  @@map("menu_productos")
}

model FoodCategory {
  id           String                    @id @default(uuid()) @map("id")
  name         String                    @unique @map("nombre")
  description  String?                   @map("descripcion")
  createdAt    DateTime                  @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt    DateTime                  @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  menuProducts MenuProductFoodCategory[] @relation("FoodCategoryToMenuProducts")

  @@map("categorias_comida")
}

model MenuProductFoodCategory {
  menuProductId  String       @map("menu_producto_id")
  foodCategoryId String       @map("categoria_comida_id")
  foodCategory   FoodCategory @relation("FoodCategoryToMenuProducts", fields: [foodCategoryId], references: [id], onDelete: Cascade)
  menuProduct    MenuProduct  @relation(fields: [menuProductId], references: [id], onDelete: Cascade)

  @@id([menuProductId, foodCategoryId])
  @@map("menu_producto_categorias_comida")
}

/// Representa un grupo de opciones para personalizar un producto de menú (ej. "Acompañamientos", "Bebidas").
model OpcionGrupo {
  id            String      @id @default(uuid()) @map("id")
  name          String      @map("nombre")
  minQuantity   Int         @map("cantidad_minima")
  maxQuantity   Int         @map("cantidad_maxima")
  quantityType  String      @map("tipo_cantidad")
  menuProductId String      @map("menu_producto_id")
  isDeleted     Boolean     @default(false) @map("borrado")
  deletedAt     DateTime?   @map("fecha_borrado")
  createdAt     DateTime    @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  options       Opcion[]
  menuProduct   MenuProduct @relation(fields: [menuProductId], references: [id], onDelete: Cascade)

  @@map("opciones_grupos")
}

/// Representa una opción dentro de un grupo (ej. "Papas Fritas Grandes", "Coca Cola Zero").
model Opcion {
  id                String       @id @default(uuid()) @map("id")
  legacyId          Int?         @unique @map("legacy_id")
  name              String       @map("nombre")
  hasStock          Boolean      @map("tiene_stock")
  index             Int          @map("orden")
  priceFinal        Decimal      @default(0.0) @map("precio_final") @db.Decimal(10, 2)
  priceWithoutTaxes Decimal      @default(0.0) @map("precio_sin_impuestos") @db.Decimal(10, 2)
  taxesAmount       Decimal      @default(0.0) @map("monto_impuestos") @db.Decimal(10, 2)
  priceModifierType String       @map("tipo_modificador_precio")
  maxQuantity       Int?         @map("cantidad_maxima")
  optionGroupId     String       @map("id_grupo_opcion")
  isDeleted         Boolean      @default(false) @map("borrado")
  deletedAt         DateTime?    @map("fecha_borrado")
  createdAt         DateTime     @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  menuProductId     String?
  optionImages      OptionImage?
  optionGroup       OpcionGrupo  @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  menuProduct       MenuProduct? @relation(fields: [menuProductId], references: [id], onDelete: Cascade)

  @@map("opciones")
}

/// Tabla intermedia para la relación M:N entre Opcion e Image.
model OptionImage {
  optionId String @id @map("opcion_id")
  imageId  String @map("imagen_id")
  order    Int?   @map("orden")
  url      String
  option   Opcion @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@map("opcion_imagenes")
}

model Address {
  id            String            @id @default(uuid()) @map("id")
  street        String            @map("calle")
  number        String?           @map("numero")
  apartment     String?           @map("departamento")
  city          String            @map("ciudad")
  province      String            @map("provincia")
  country       String            @default("Argentina") @map("pais")
  postalCode    String?           @map("codigo_postal")
  latitude      Decimal?          @map("latitud") @db.Decimal(10, 7)
  longitude     Decimal?          @map("longitud") @db.Decimal(10, 7)
  isDefault     Boolean           @default(false) @map("es_predeterminada")
  enabled       Boolean           @default(true) @map("habilitada")
  notes         String?           @map("notas")
  userId        String?           @map("usuario_id")
  businessId    String?           @map("negocio_id")
  createdAt     DateTime          @default(now()) @map("creado_en")
  updatedAt     DateTime          @updatedAt @map("actualizado_en")
  zoneIndex     AddressZoneIndex?
  business      Business?         @relation("BusinessAddresses", fields: [businessId], references: [id])
  user          User?             @relation("UserAddresses", fields: [userId], references: [id])
  deliveryOrder Order[]           @relation("OrderDeliveryAddress")
  pickupOrder   Order[]           @relation("OrderPickupAddress")
  order         Order[]           @relation("AddressToOrder")

  @@index([userId])
  @@index([businessId])
  @@index([enabled])
  @@index([userId, enabled])
  @@map("direcciones")
}

/// Representa una orden de un cliente.
model Order {
  id                         String              @id @default(uuid()) @map("id")
  idTemp                     String?             @unique @map("id_temp")
  userId                     String?             @map("usuario_id")
  businessId                 String              @map("negocio_id")
  deliveryAddressId          String?             @map("direccion_entrega_id")
  pickupAddressId            String?             @map("direccion_retiro_id")
  deliveryCompanyId          String?
  customerName               String              @map("cliente_nombre")
  customerPhone              String              @map("cliente_telefono")
  customerAddress            String?             @map("cliente_direccion")
  customerObservations       String?             @map("cliente_observaciones")
  customerAddresslatitude    Decimal?            @map("cliente_direccion_latitud") @db.Decimal(10, 7)
  customerAddresslongitude   Decimal?            @map("cliente_direccion_longitud") @db.Decimal(10, 7)
  businessName               String              @map("negocio_nombre")
  businessPhone              String              @map("negocio_telefono")
  businessAddress            String              @map("negocio_direccion")
  businessObservations       String?             @map("negocio_observaciones")
  businessAddresslatitude    Decimal             @default(0) @map("negocio_direccion_latitud") @db.Decimal(10, 7)
  businessAddresslongitude   Decimal             @default(0) @map("negocio_direccion_longitud") @db.Decimal(10, 7)
  deliveryCompanyName        String?             @map("cadeteria_nombre")
  deliveryCompanyPhone       String?             @map("cadeteria_telefono")
  /// Total de la ORDEN (productos/servicios, sin incluir costo de delivery).
  total                      Decimal             @map("total") @db.Decimal(10, 2)
  /// Costo total del servicio de delivery.
  totalDeliveryCost          Decimal             @default(0) @map("costo_total_delivery") @db.Decimal(10, 2)
  /// Método de pago eleguido por el cliente.
  orderPaymentMethod         PaymentMethodType   @default(TRANSFER) @map("metodo_pago_orden")
  /// Estado de pago de la ORDEN.
  paymentStatus              PaymentStatus       @default(PENDING) @map("estado_pago_orden")
  /// Quién paga la tarifa de envío: CLIENT o BUSINESS si es por delibery.
  cadetPaymentPayer          CadetPaymentPayer?  @default(CLIENT) @map("quien_paga_cadete")
  /// Método de pago que el cliente usa para pagar el envío al cadete (si aplica).
  cadetPaymentMethod         PaymentMethodType?  @map("metodo_pago_cadete")
  paymentReceiptUrl          String?
  paymentInstructions        String?
  paymentHolderName          String?
  /// Desglose de **montos que el cliente DEBE pagar** (Orden + Delivery).
  paymentExpected            Json                @map("pago_esperado")
  /// Desglose de **montos que el negocio/sistema ya HA RECIBIDO/CONFIRMADO** del cliente.
  paymentReceived            Json                @map("pago_recibido")
  /// Indica si el cadete tiene la responsabilidad de **COBRAR** el monto de la ORDEN (productos) al cliente.
  isCadetCollectingOrder     Boolean?            @default(false) @map("cadete_cobra_orden")
  deliveryType               DeliveryType        @default(DELIVERY) @map("tipo_entrega")
  status                     OrderStatus         @default(PENDING) @map("estado")
  origin                     OrderOrigin         @default(APP) @map("origen")
  isTest                     Boolean             @default(false) @map("es_prueba")
  notes                      String?             @map("notas")
  /// NULL = pedido inmediato.
  /// Con valor = fecha y hora solicitada por el cliente.
  scheduledAt                DateTime?           @map("programado_para")
  shortCode                  String?
  dailyNumber                Int?
  assignedCashRegisterTurnId String?             @map("assigned_cash_register_turn_id")
  createdAt                  DateTime            @default(now()) @map("creado_en")
  updatedAt                  DateTime            @updatedAt @map("actualizado_en")
  deliveryStatus             DeliveryStatus      @default(NOT_APPLICABLE) @map("estado_envio")
  OrderDiscount              OrderDiscount[]
  financialMovements         FinancialMovement[]
  OrderItem                  OrderItem[]
  assignedCashRegisterTurn   CashRegisterTurn?   @relation("AssignedCashTurn", fields: [assignedCashRegisterTurnId], references: [id])
  deliveryCompany            DeliveryCompany?    @relation("DeliveryCompanyOrder", fields: [deliveryCompanyId], references: [id])
  deliveryAddress            Address?            @relation("OrderDeliveryAddress", fields: [deliveryAddressId], references: [id])
  pickupAddress              Address?            @relation("OrderPickupAddress", fields: [pickupAddressId], references: [id])
  business                   Business            @relation(fields: [businessId], references: [id])
  user                       User?               @relation(fields: [userId], references: [id])
  events                     OrderStateEvent[]
  addresses                  Address[]           @relation("AddressToOrder")

  @@index([businessId])
  @@index([userId])
  @@index([deliveryCompanyId])
  @@index([createdAt])
  @@index([businessId, scheduledAt])
  @@map("ordenes")
}

model OrderStateEvent {
  id        String    @id @default(uuid())
  orderId   String    @map("orden_id")
  stateType StateType @map("tipo_estado")
  value     String    @map("valor")
  author    String?   @map("autor")
  createdAt DateTime  @default(now()) @map("creado_en")
  order     Order     @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("ordenes_eventos_estado")
}

/// Representa un ítem individual dentro de una orden.
model OrderItem {
  id                   String             @id @default(uuid()) @map("id")
  orderId              String             @map("id_orden")
  menuProductId        String             @map("id_menu_producto")
  productName          String             @map("nombre_producto")
  productDescription   String?            @map("descripcion_producto")
  productImageUrl      String?            @map("url_imagen_producto")
  quantity             Int                @map("cantidad")
  priceAtPurchase      Decimal            @map("precio_al_momento_compra") @db.Decimal(10, 2)
  costAtPurchase       Decimal            @default(0) @map("cost_at_purchase") @db.Decimal(10, 2)
  notes                String?            @map("notas")
  productPaymentMethod PaymentMethodType  @default(TRANSFER) @map("metodo_pago_producto")
  createdAt            DateTime           @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  ordersId             String?
  optionGroups         OrderOptionGroup[]
  menuProduct          MenuProduct        @relation(fields: [menuProductId], references: [id])
  order                Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("items_orden")
}

/// Representa un descuento específico aplicado a una orden. Permite múltiples descuentos por orden.
model OrderDiscount {
  id        String   @id @default(uuid()) @map("id")
  orderId   String   @map("id_orden")
  amount    Decimal  @map("monto") @db.Decimal(10, 2)
  type      String   @map("tipo")
  notes     String?  @map("notas")
  paidBy    String?  @map("pagado_por")
  createdAt DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("fecha_actualizacion") @db.Timestamptz(3)
  ordersId  String?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("descuentos_orden")
}

model OrderOptionGroup {
  id            String        @id @default(uuid())
  opcionGrupoId String?
  groupName     String
  minQuantity   Int
  maxQuantity   Int
  quantityType  String
  orderItemId   String
  options       OrderOption[]
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])
}

model OrderOption {
  id                 String           @id @default(uuid())
  orderOptionGroupId String
  opcionId           String?
  optionName         String
  priceFinal         Decimal          @db.Decimal(10, 2)
  priceWithoutTaxes  Decimal          @db.Decimal(10, 2)
  taxesAmount        Decimal          @db.Decimal(10, 2)
  priceModifierType  String
  quantity           Int
  orderOptionGroup   OrderOptionGroup @relation(fields: [orderOptionGroupId], references: [id])
}

model Notification {
  id               String                @id @default(uuid())
  category         NotificationCategory
  type             String
  title            String
  message          String
  timestamp        DateTime              @default(now())
  isRead           Boolean               @default(false)
  link             String?
  priority         NotificationPriority? @default(MEDIUM)
  targetEntityId   String
  targetEntityType String                @default("USER")

  @@index([targetEntityId, targetEntityType, isRead, timestamp(sort: Desc)])
  @@index([targetEntityId, targetEntityType, isRead])
}

model PushSubscription {
  id        String                   @id @default(uuid())
  endpoint  String                   @unique
  p256dh    String
  auth      String
  createdAt DateTime                 @default(now())
  targets   PushSubscriptionTarget[]
}

model PushSubscriptionTarget {
  id               String           @id @default(uuid())
  subscriptionId   String
  targetEntityId   String
  targetEntityType String
  subscription     PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, targetEntityId, targetEntityType])
  @@index([targetEntityId, targetEntityType])
}

model DeliveryCompany {
  id               String                @id @default(uuid())
  name             String
  phone            String
  isActive         Boolean               @default(true)
  ownerId          String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  owner            User                  @relation(fields: [ownerId], references: [id])
  DeliveryEmployee DeliveryEmployee[]
  zones            DeliveryZone[]
  priceMatrices    DeliveryPriceMatrix[]
  orders           Order[]               @relation("DeliveryCompanyOrder")
}

model DeliveryZone {
  id                String                @id @default(uuid())
  name              String
  price             Decimal
  geometry          Json?
  hasTimeLimit      Boolean               @default(false)
  startTime         String?
  endTime           String?
  isActive          Boolean               @default(true)
  deliveryCompanyId String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deliveryCompany   DeliveryCompany       @relation(fields: [deliveryCompanyId], references: [id])
  addressIndices    AddressZoneIndex[]
  priceMatrices     DeliveryPriceMatrix[]
  h3Indices         H3Index[]
}

model MacroZone {
  id             String                @id @default(uuid())
  name           String                @unique
  geometry       Json?
  isActive       Boolean               @default(true)
  addressIndices AddressZoneIndex[]
  priceMatrix    DeliveryPriceMatrix[]
  h3Indices      H3Index[]

  @@map("macro_zones")
}

model DeliveryPriceMatrix {
  id                String          @id @default(uuid())
  deliveryCompanyId String
  deliveryZoneId    String
  macroZoneId       String
  price             Decimal
  company           DeliveryCompany @relation(fields: [deliveryCompanyId], references: [id], onDelete: Cascade)
  barrio            DeliveryZone    @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)
  macroZone         MacroZone       @relation(fields: [macroZoneId], references: [id], onDelete: Cascade)

  @@unique([deliveryCompanyId, deliveryZoneId, macroZoneId])
  @@map("delivery_price_matrix")
}

model AddressZoneIndex {
  id             String        @id @default(uuid())
  addressId      String        @unique
  macroZoneId    String?
  deliveryZoneId String?
  address        Address       @relation(fields: [addressId], references: [id])
  barrio         DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  macroZone      MacroZone?    @relation(fields: [macroZoneId], references: [id])

  @@map("address_zone_index")
}

model H3Index {
  id             String        @id @default(uuid())
  h3Index        String
  macroZoneId    String?
  deliveryZoneId String?
  deliveryZone   DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  macroZone      MacroZone?    @relation(fields: [macroZoneId], references: [id])

  @@index([h3Index])
  @@map("h3_indices")
}

model DeliveryCommandX {
  id                   String                 @id @default(uuid())
  businessId           String
  orderId              String
  command              DeliveryCommandTypeX
  status               DeliveryCommandStatusX @default(PENDING)
  originName           String?
  originAddress        String?
  originLatitude       Float?
  originLongitude      Float?
  destinationAddress   String?
  destinationLatitude  Float?
  destinationLongitude Float?
  zoneId               String?
  notes                String?
  quotedCost           Int?
  externalId           String?
  failureReason        String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([businessId, orderId])
  @@index([businessId])
  @@index([orderId])
  @@index([status])
  @@index([command])
}

model DeliveryDispatch {
  id                    String                 @id @default(uuid())
  businessId            String
  orderId               String
  provider              String                 @default("INTERNAL")
  externalId            String?
  status                DeliveryDispatchStatus @default(DRAFT)
  quotedCost            Int?
  quoteExpiresAt        DateTime?
  originName            String?
  originAddress         String?
  originLatitude        Float?
  originLongitude       Float?
  destinationName       String?
  destinationAddress    String?
  destinationLatitude   Float?
  destinationLongitude  Float?
  zoneId                String?
  originPaymentAmount   Int                    @default(0)
  originPaymentDeferred Boolean                @default(false)
  courierName           String?
  courierPhone          String?
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  commands              DeliveryCommand[]

  @@unique([businessId, orderId])
  @@index([businessId])
  @@index([orderId])
  @@index([status])
  @@index([externalId])
}

model DeliveryCommand {
  id                 String                 @id @default(uuid())
  deliveryDispatchId String
  actor              CommandActor
  command            DeliveryCommandType
  status             CommandExecutionStatus @default(PENDING)
  idempotencyKey     String?
  payload            Json?
  response           Json?
  failureReason      String?
  createdAt          DateTime               @default(now())
  deliveryDispatch   DeliveryDispatch       @relation(fields: [deliveryDispatchId], references: [id], onDelete: Cascade)

  @@unique([deliveryDispatchId, idempotencyKey])
  @@index([deliveryDispatchId])
  @@index([command])
  @@index([status])
  @@index([idempotencyKey])
}

/// Cuenta financiera real o abstracta donde reside el dinero.
/// Ej: Caja, Mercado Pago, Banco, Caja Fuerte.
model TreasuryAccount {
  id                         String                      @id @default(uuid())
  idTemp                     String?                     @unique @map("id_temp")
  businessId                 String                      @map("business_id")
  name                       String
  type                       TreasuryAccountType         @default(CASH)
  currency                   String                      @default("ARS")
  currentBalance             Decimal                     @default(0) @map("current_balance") @db.Decimal(12, 2)
  isActive                   Boolean                     @default(true) @map("is_active")
  createdAt                  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  cashRegisterPaymentMethods CashRegisterPaymentMethod[]
  cashRegisterTurns          CashRegisterTurn[]          @relation("TurnTreasuryAccount")
  cashRegisters              CashRegister[]              @relation("DefaultTreasuryAccount")
  financialMovements         FinancialMovement[]         @relation("MovementTreasuryAccount")

  @@index([businessId])
  @@map("treasury_accounts")
}

/// Terminal física o lógica desde donde se realizan cobros.
/// Ej: Mostrador 1, Barra, Delivery.
model CashRegister {
  id                           String                      @id @default(uuid())
  idTemp                       String?                     @unique @map("id_temp")
  businessId                   String                      @map("business_id")
  name                         String
  defaultTreasuryAccountId     String                      @map("default_treasury_account_id")
  isActive                     Boolean                     @default(true) @map("is_active")
  createdAt                    DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  defaultTreasuryAccountIdTemp String?                     @map("default_treasury_account_id_temp")
  cashRegisterPaymentMethods   CashRegisterPaymentMethod[]
  turns                        CashRegisterTurn[]
  defaultTreasuryAccount       TreasuryAccount             @relation("DefaultTreasuryAccount", fields: [defaultTreasuryAccountId], references: [id])

  @@index([businessId])
  @@map("cash_registers")
}

/// Configuración de los medios de pago habilitados
/// para una determinada caja.
model CashRegisterPaymentMethod {
  id                    String                     @id @default(uuid())
  idTemp                String?                    @unique @map("id_temp")
  businessId            String                     @map("business_id")
  cashRegisterId        String                     @map("cash_register_id")
  paymentMethod         PaymentMethodTypeFinancial @map("payment_method")
  treasuryAccountId     String                     @map("treasury_account_id")
  isActive              Boolean                    @default(true) @map("is_active")
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")
  treasuryAccountIdTemp String                     @map("treasury_account_id_temp")
  cashRegisterIdTemp    String                     @map("cash_register_id_temp")
  cashRegister          CashRegister               @relation(fields: [cashRegisterId], references: [id])
  treasuryAccount       TreasuryAccount            @relation(fields: [treasuryAccountId], references: [id])

  @@unique([cashRegisterId, paymentMethod])
  @@index([businessId])
  @@index([cashRegisterId])
  @@index([cashRegisterIdTemp])
  @@index([treasuryAccountId])
  @@index([treasuryAccountIdTemp])
  @@map("cash_register_payment_methods")
}

/// Sesión de trabajo / arqueo de una caja.
model CashRegisterTurn {
  id                    String              @id @default(uuid())
  businessId            String              @map("business_id")
  openedByUserId        String              @map("opened_by_user_id")
  closedByUserId        String?             @map("closed_by_user_id")
  openingDate           DateTime            @default(now()) @map("opening_date")
  openingAmount         Decimal             @default(0) @map("opening_amount") @db.Decimal(10, 2)
  closingDate           DateTime?           @map("closing_date")
  declaredClosingAmount Decimal?            @map("declared_closing_amount") @db.Decimal(10, 2)
  systemClosingAmount   Decimal?            @map("system_closing_amount") @db.Decimal(10, 2)
  difference            Decimal?            @db.Decimal(10, 2)
  status                CashRegisterStatus  @default(OPEN)
  updatedAt             DateTime            @updatedAt @map("updated_at")
  cashRegisterId        String              @map("cash_register_id")
  createdAt             DateTime            @default(now()) @map("created_at")
  openingNotes          String?             @map("opening_notes")
  treasuryAccountId     String              @map("treasury_account_id")
  idTemp                String              @unique @map("id_temp")
  closingNotes          String?
  cashRegister          CashRegister        @relation(fields: [cashRegisterId], references: [id])
  treasuryAccount       TreasuryAccount     @relation("TurnTreasuryAccount", fields: [treasuryAccountId], references: [id])
  financialMovements    FinancialMovement[] @relation("CurrentCashTurn")
  referencedMovements   FinancialMovement[] @relation("ReferenceCashTurn")
  assignedOrders        Order[]             @relation("AssignedCashTurn")

  @@index([businessId, status])
  @@index([cashRegisterId])
  @@map("cash_register_turns")
}

/// Registro único de movimientos financieros.
model FinancialMovement {
  id                          String                      @id @default(uuid())
  approvedByUserId            String?                     @map("approved_by_user_id")
  type                        FinancialMovementType
  status                      FinancialMovementStatus     @default(CONFIRMED)
  amount                      Decimal                     @db.Decimal(12, 2)
  paymentMethod               PaymentMethodTypeFinancial? @map("payment_method")
  affectsCashRegister         Boolean                     @default(true) @map("affects_cash_register")
  description                 String
  notes                       String?
  externalReference           String?                     @map("external_reference")
  sequence                    Int                         @default(1)
  date                        DateTime                    @default(now())
  orderId                     String?                     @map("order_id")
  cashRegisterTurnId          String?                     @map("cash_register_turn_id")
  referenceCashRegisterTurnId String?                     @map("reference_cash_register_turn_id")
  businessId                  String                      @map("business_id")
  createdAt                   DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  fixedExpenseIdTemp          String?                     @map("fixed_expense_id_temp")
  pendingCommitmentIdTemp     String?                     @map("pending_commitment_id_temp")
  transferGroupId             String?                     @map("transfer_group_id")
  treasuryAccountId           String?                     @map("treasury_account_id")
  updatedAt                   DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  userId                      String                      @map("user_id")
  idTemp                      String?                     @unique @map("id_temp")
  cashRegisterTurn            CashRegisterTurn?           @relation("CurrentCashTurn", fields: [cashRegisterTurnId], references: [id])
  order                       Order?                      @relation(fields: [orderId], references: [id])
  referenceCashRegisterTurn   CashRegisterTurn?           @relation("ReferenceCashTurn", fields: [referenceCashRegisterTurnId], references: [id])
  treasuryAccount             TreasuryAccount?            @relation("MovementTreasuryAccount", fields: [treasuryAccountId], references: [id])

  @@index([businessId])
  @@index([cashRegisterTurnId])
  @@index([treasuryAccountId])
  @@index([transferGroupId])
  @@map("financial_movements")
}

